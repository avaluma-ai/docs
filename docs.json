{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Avaluma AI",
  "theme": "luma",
  "colors": {
    "primary": "#564A99",
    "light": "#ffffff"
  },
  "favicon": {
    "light": "/images/favicon.png",
    "dark": "/images/favicon.png"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/avaluma-ai/avaluma-examples"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "hidden": true,
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Get Started",
                "pages": [
                  "introduction",
                  "quickstart",
                  "architecture"
                ]
              },
              {
                "group": "Avatar Server",
                "pages": [
                  "avatar-server/overview",
                  "avatar-server/setup",
                  "avatar-server/https-proxy"
                ]
              },
              {
                "group": "LiveKit Agent",
                "pages": [
                  "livekit-agent/overview",
                  "livekit-agent/conversational-agent",
                  "livekit-agent/external-audio"
                ]
              },
              {
                "group": "Configuration",
                "pages": [
                  "configuration/environment-variables",
                  "configuration/avatar-files"
                ]
              },
              {
                "group": "Testing & Troubleshooting",
                "pages": [
                  "testing/test-clients",
                  "testing/troubleshooting"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "de",
        "groups": [
          {
            "group": "Agents",
            "pages": [
              "embedding"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/avaluma_logo_for_mail.png",
    "dark": "/images/avaluma_logo_for_mail.png",
    "href": "https://avaluma.ai"
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "family": "Capriola"
  }
}
